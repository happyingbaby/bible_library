{
  "name": "scripture-lecture-library",
  "version": "0.1.0",
  "private": true,
  "description": "Offline Bible lecture library",
  "author": "Bible Lecture Library",
  "main": "desktop/main.cjs",
  "scripts": {
    "web": "npm run build && node scripts/web.cjs",
    "test:web": "node --test scripts/web.test.cjs",
    "dev": "node scripts/dev.cjs",
    "build": "tsc --noEmit -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "desktop": "electron .",
    "package:mac": "npm run package:mac:native",
    "package:mac:native": "npm run build && electron-builder --mac dmg --publish never --config.electronDist=node_modules/electron/dist",
    "package:mac:dir": "npm run build && electron-builder --mac dir --publish never --config.electronDist=node_modules/electron/dist",
    "package:win": "npm run build && electron-builder --win nsis --publish never",
    "test:backend": "uv run --project backend --locked python -m pytest backend/tests -q",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "sync:backend": "uv sync --project backend --locked",
    "predev": "npm run sync:backend",
    "predesktop": "npm run sync:backend",
    "preweb": "npm run sync:backend",
    "package:backend": "node scripts/package-backend.cjs",
    "test:dev": "node --test scripts/dev.test.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electron/universal": "^2.0.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "local.scripture.library",
    "productName": "圣经讲义",
    "directories": {
      "output": "release"
    },
    "files": [
      "frontend/dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.reference",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-windows-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
